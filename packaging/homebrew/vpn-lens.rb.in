cask "vpn-lens" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "https://github.com/wall-low/vpn-lens/releases/download/v#{version}/VPN-Lens-#{version}.zip"
  name "VPN Lens"
  desc "Menu bar utility that shows which apps go through the VPN"
  homepage "https://github.com/wall-low/vpn-lens"

  livecheck do
    url :url
    strategy :github_latest
  end

  depends_on macos: :sonoma

  app "VPN Lens.app"

  uninstall quit: "io.github.wall-low.vpnlens"

  zap trash: [
    "~/Library/Application Support/VPN Lens",
    "~/Library/Preferences/io.github.wall-low.vpnlens.plist",
  ]

  caveats <<~EOS
    VPN Lens is not notarized. On first launch macOS blocks it:
    open System Settings > Privacy & Security and click "Open Anyway".
  EOS
end
